{
  "name": "namy-hubspot-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Read/create/update-only proxy in front of the HubSpot Contacts API for third-party partners",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy:dev": "cdk deploy --context env=dev",
    "deploy:prod": "cdk deploy --context env=prod --require-approval broadening"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1147.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
